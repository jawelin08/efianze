<?xml version='1.0' encoding='utf-8'?>
<widget id="com.oscar.diaz" versionCode="33" version="2.01.01" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
     <name>NextFinanz</name>
    <description>
         NextFinanz: Control de gastos y finanzas personales.
    </description>
	
    <meta name="description" content="NextFinanz: Control de gastos y finanzas personales."/>
	
    <author email="finanz.application@gmail.com" href="https://github.com/OscarFDiaz">
        Oscar Diaz
    </author>
	
    <content src="index.html" />
	
    <access origin="*" />
	
    <plugin name="cordova-plugin-whitelist" />
	
    <platform name="android">
        <allow-intent href="market:*" />
        <icon src="www/assets/branding/icon-ldpi.png" density="ldpi" />
        <icon src="www/assets/branding/icon-mdpi.png" density="mdpi" />
        <icon src="www/assets/branding/icon-hdpi.png" density="hdpi" />
        <icon src="www/assets/branding/icon-xhdpi.png" density="xhdpi" />
        <icon src="www/assets/branding/icon-xxhdpi.png" density="xxhdpi" />
        <icon src="www/assets/branding/icon-xxxhdpi.png" density="xxxhdpi" />
    </platform>
	
	<preference name="android-minSdkVersion" value="22" /> 
    <preference name="android-targetSdkVersion" value="33" /> 
</widget>
